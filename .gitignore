# ==========================================
# Forma AI - Git Ignore
# ==========================================

# -------------------------
# Node.js dependencies
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Environment variables
# -------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# -------------------------
# Build files
# -------------------------
dist/
build/
.vite/

# -------------------------
# Test / Coverage
# -------------------------
coverage/

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# Temporary files
# -------------------------
*.tmp
*.temp

# -------------------------
# VS Code
# -------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# -------------------------
# Other IDEs
# -------------------------
.idea/
*.iml

# -------------------------
# Operating System
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Cache
# -------------------------
.cache/
.parcel-cache/
.eslintcache

# -------------------------
# Python (if used later)
# -------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/

# -------------------------
# Generated files
# -------------------------
*.generated.*